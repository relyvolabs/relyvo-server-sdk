# Copy to `.env` for the examples. Never commit a real key.

# Project API key, server-side only. Create it in the dashboard.
RELYVO_API_KEY=rv_replace_me

# Where /v1/api/... resolves. Through the dashboard that includes /api.
RELYVO_API_URL=https://relyvo.example.com/api

# Chat REST origin, only needed for chat calls. Must be reachable from your backend.
RELYVO_CHAT_URL=https://chat-api.example.com
