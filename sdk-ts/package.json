{
  "name": "@relyvolabs/server-sdk",
  "version": "0.1.0",
  "description": "Official server SDK for the Relyvo platform: exchange an API key for short-lived video and chat tokens.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "relyvo",
    "rtc",
    "chat",
    "sdk",
    "server"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/relyvolabs/relyvo-server-sdk.git",
    "directory": "sdk-ts"
  },
  "homepage": "https://github.com/relyvolabs/relyvo-server-sdk#readme",
  "bugs": {
    "url": "https://github.com/relyvolabs/relyvo-server-sdk/issues"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
